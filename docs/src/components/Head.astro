---
/**
 * Starlight's `<head>` plus structured data for every docs page:
 * a BreadcrumbList (Home → Documentation → page, the trail a search result
 * shows under the title) and a TechArticle carrying the page's headline,
 * description and last-updated date. Starlight's own head tags — canonical,
 * Open Graph, the meta description — come from the default component.
 */
import Default from "@astrojs/starlight/components/Head.astro";

const { entry, siteTitle, lastUpdated, lang } = Astro.locals.starlightRoute;
const site = Astro.site ?? new URL("https://librariarr.dev/");
const pageUrl = new URL(Astro.url.pathname, site);
const docsUrl = new URL("/docs/", site);
const isDocsIndex = pageUrl.pathname === docsUrl.pathname;

const crumbs = [
  { name: siteTitle, item: site.href },
  { name: "Documentation", item: docsUrl.href },
  ...(isDocsIndex ? [] : [{ name: entry.data.title, item: pageUrl.href }]),
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.item,
      })),
    },
    {
      "@type": "TechArticle",
      headline: entry.data.title,
      ...(entry.data.description
        ? { description: entry.data.description }
        : {}),
      url: pageUrl.href,
      inLanguage: lang,
      ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
      isPartOf: { "@type": "WebSite", name: siteTitle, url: site.href },
    },
  ],
};
---

<Default><slot /></Default>
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
