generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  plexId                String?                @unique
  plexToken             String?
  localUsername         String?                @unique
  passwordHash          String?
  email                 String?
  username              String
  sessionVersion        Int                    @default(0)
  ssoSubject            String?
  ssoIssuer             String?
  ssoProvider           String?
  ssoEnabled            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  mediaServers          MediaServer[]
  ruleSets              RuleSet[]
  collections           Collection[]
  appSettings           AppSettings?
  sonarrInstances       SonarrInstance[]
  radarrInstances       RadarrInstance[]
  lidarrInstances       LidarrInstance[]
  seerrInstances        SeerrInstance[]
  tracearrInstances     TracearrInstance[]
  lifecycleActions      LifecycleAction[]
  lifecycleExceptions   LifecycleException[]
  blackoutSchedules     BlackoutSchedule[]
  prerollPresets        PrerollPreset[]
  prerollSchedules      PrerollSchedule[]
  savedQueries          SavedQuery[]
  trashManagedResources TrashManagedResource[]
  apiKeys               ApiKey[]

  // SSO subjects are only unique per-issuer. Two users can have sub "abc" if
  // they came from different IdPs. This composite key prevents the cross-IdP
  // collision attack where switching the configured IdP could let a stranger
  // log in as the linked admin.
  @@unique([ssoSubject, ssoIssuer])
}

model AppSettings {
  id                              String    @id @default(cuid())
  userId                          String    @unique
  user                            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncSchedule                    String    @default("DAILY")
  lastScheduledSync               DateTime?
  accentColor                     String    @default("default")
  logRetentionDays                Int       @default(7)
  lifecycleDetectionSchedule      String    @default("EVERY_6H")
  lastScheduledLifecycleDetection DateTime?
  lifecycleExecutionSchedule      String    @default("EVERY_6H")
  lastScheduledLifecycleExecution DateTime?
  dashboardLayout                 Json?
  columnPreferences               Json?
  cardDisplayPreferences          Json?
  chipColors                      Json?
  maintenanceMode                 Boolean   @default(false)
  maintenanceMessage              String    @default("")
  maintenanceDelay                Int       @default(30)
  transcodeManagerEnabled         Boolean   @default(false)
  transcodeManagerMessage         String    @default("")
  transcodeManagerDelay           Int       @default(30)
  transcodeManagerCriteria        Json?
  // Skip streams the server reports as hardware-accelerated (GPU encode), which
  // cost the CPU little. Off by default so existing criteria keep their meaning.
  transcodeManagerExemptHardware  Boolean   @default(false)
  // Discord notifications
  discordWebhookUrl               String?
  discordWebhookUsername          String?
  discordWebhookAvatarUrl         String?
  discordNotifyMaintenance        Boolean   @default(false)
  /// Tell Discord when an API key is created or deleted — a stolen browser
  /// session can mint one, so on by default wherever a webhook is set.
  discordNotifyApiKeys            Boolean   @default(true)
  localAuthEnabled                Boolean   @default(false)
  // Allow signing in with Plex from the login page. When false, the Plex
  // button is hidden and /api/auth/plex/token rejects logins — but the
  // user's plexToken stays attached for media server / library sync.
  plexLoginEnabled                Boolean   @default(true)
  // SSO — when ssoEnabled is true, the local username/password form is hidden
  // on the login screen. Plex login remains available if a Plex account is linked.
  ssoEnabled                      Boolean   @default(false)
  ssoMode                         String    @default("OIDC")
  oidcIssuer                      String?
  oidcClientId                    String?
  oidcClientSecret                String?
  oidcScopes                      String    @default("openid profile email")
  oidcUsernameClaim               String    @default("preferred_username")
  forwardAuthUserHeader           String    @default("Remote-User")
  forwardAuthEmailHeader          String    @default("Remote-Email")
  forwardAuthNameHeader           String    @default("Remote-Name")
  // Single-step undo for SSO config changes. Snapshotted on every PUT to
  // /api/settings/sso. Resistant to backup rotation — gives admins a
  // recovery path when bad credentials are saved and the only available
  // backups all have the broken state.
  previousSsoConfig               Json?
  preferredTitleServerId          String?
  preferredArtworkServerId        String?
  // Backup
  backupSchedule                  String    @default("DAILY")
  backupRetentionCount            Int       @default(7)
  backupEncryptionPassword        String?
  lastBackupAt                    DateTime?
  // User exclusion lists
  maintenanceExcludedUsers        String[]  @default([])
  transcodeManagerExcludedUsers   String[]  @default([])
  // Scheduling
  scheduledJobTime                String    @default("00:00")
  // Display
  dedupStats                      Boolean   @default(true)
  // Real-time media-server WebSocket sync (instant sessions/enforcement,
  // incremental library + watch-history sync). Master switch — off closes all
  // server WebSockets and falls back to scheduled polling only.
  realtimeSync                    Boolean   @default(true)
  // Retention
  actionHistoryRetentionDays      Int       @default(30)
  // Deletion stats
  /// Ceiling on how many items ONE destructive run may act on before it needs a
  /// human. `null` (the default) means no ceiling — Librariarr is meant to be
  /// automated, and a user whose rules legitimately select thousands of items
  /// should not be second-guessed for it.
  ///
  /// This is not a safety net against a rule being wrong; it is a blast-radius
  /// limit for the case where something UPSTREAM of the rule is wrong. Every
  /// vacuous-match guard refuses a known failure, and each one was written after
  /// finding a way the engine could match a whole library on absent evidence.
  /// A ceiling bounds the ones nobody has found yet, which is the only defence
  /// that does not depend on having enumerated the hazards.
  ///
  /// Counted per RUN across every rule set, and only over destructive actions —
  /// unmonitor, tag and search runs are unaffected. Exceeding it holds the whole
  /// batch as PENDING rather than trimming it to the limit: acting on an
  /// arbitrary subset of a suspect match set is not safer, just quieter.
  maxAutoDeleteItems              Int?
  deletionStatsResetAt            DateTime?
  /// Until this passes, a grouped SERIES or MUSIC action (one that acts on a
  /// show or an artist, not a single item) is scheduled no earlier than it.
  /// Before migration `0024` the scheduled executor cancelled every such action
  /// as an identity change, so none had ever run; that migration held the
  /// pending ones for a week and set this, so the ones scheduled during that
  /// week wait as long — a rule set with no delay had nothing pending to hold.
  /// Null on an install created since, which has no such backlog.
  groupedActionsHeldUntil         DateTime?
  // AI analysis (read-only library assistant). Provider-neutral so any backend
  // works — "openai-compatible" covers OpenAI, Ollama, LM Studio, OpenRouter,
  // Groq, vLLM, LocalAI, etc.; "anthropic" is the native Claude Messages API.
  // aiBaseUrl overrides the provider default (required for local models);
  // aiApiKey is optional (local models often need none) and masked by sanitize().
  aiEnabled                       Boolean   @default(false)
  aiProvider                      String    @default("openai-compatible")
  aiBaseUrl                       String?
  aiApiKey                        String?
  aiModel                         String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
}

enum MediaServerType {
  PLEX
  JELLYFIN
  EMBY
}

model MediaServer {
  id                       String          @id @default(cuid())
  userId                   String
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                     MediaServerType @default(PLEX)
  name                     String
  url                      String
  externalUrl              String?
  accessToken              String
  machineId                String?
  tlsSkipVerify            Boolean         @default(false)
  enabled                  Boolean         @default(true)
  /// The Tracearr `server_id` (UUID) this media server maps to, or null to use
  /// the server's own native watch history. Set + an enabled TracearrInstance
  /// switches `syncWatchHistory` to the incremental Tracearr import.
  tracearrServerId         String?
  /// The `started_at` of the OLDEST play Tracearr holds for this server, found
  /// once by bisecting the `until` filter (~16 calls, versus ~1,600 to page the
  /// whole history).
  ///
  /// Exists so the backfill can report determinate progress. The history API is
  /// keyset-paginated with no total and no count endpoint, so "N of M records"
  /// is unobtainable — and would be misleading anyway, because a large share of
  /// fetched plays reference media since removed from the library and are
  /// deliberately not stored, so a record-count bar could never reach 100%.
  /// Time coverage can: the walk is finished exactly when it reaches this
  /// instant. Null until measured.
  tracearrOldestPlayAt DateTime?
  /// Set when this server's stored watch history was deliberately cleared and
  /// has not yet been repopulated; null once a sync has refilled it.
  ///
  /// When this server's watch history was last ESTABLISHED — i.e. a sync
  /// successfully determined what has been played on it. `null` means it never
  /// was, or that something invalidated it since.
  ///
  /// Deliberately a positive marker rather than a "cleared at" one. An EMPTY
  /// `WatchHistory` is indistinguishable from "nobody watched anything", and
  /// the two demand opposite behaviour: every play-activity criterion
  /// (`watchedByUser`, `playCount`, `lastPlayedAt`, and the series aggregates
  /// built on them) has a negative form that goes vacuously TRUE for the entire
  /// library against absent evidence. On a DELETE rule set that is the whole
  /// library. So the question a guard has to answer is "do we KNOW what was
  /// played here", and only a positive marker answers it — a `null` default
  /// then correctly reads as "we don't", which covers a brand-new server that
  /// has never synced as well as one whose history was destroyed.
  ///
  /// Set by a SUCCESSFUL sync, including one that legitimately finds no plays
  /// (a server nobody watches is a real steady state, and must not stay paused
  /// forever). Nulled by every path that destroys history in bulk: the source
  /// switch in the `/api/servers/[id]` PUT, library and type-wide purges,
  /// disable-with-delete-data, and backup restore.
  ///
  /// `tracearrBackfillComplete` cannot serve here: unlinking sets
  /// `tracearrServerId` to null, so the server stops looking Tracearr-mapped at
  /// exactly the moment its history is emptiest.
  watchHistorySyncedAt DateTime?
  /// How far back the backfill has actually WALKED, as opposed to how far back
  /// it has stored rows.
  ///
  /// These differ, and the difference is a live-lock. Resuming from
  /// `MIN(watchedAt)` over stored rows means the position only advances when a
  /// record is importable — but a large share of old plays reference media that
  /// has since left the library and are deliberately not stored (~41% before
  /// 2023 on a real library). A contiguous unstorable stretch longer than one
  /// slice therefore leaves the position exactly where it was, and every
  /// subsequent slice re-walks the same pages forever. Recording what was SEEN
  /// guarantees forward progress regardless of what was kept.
  tracearrBackfillCursorAt DateTime?
  /// The `since` the next FORWARD pass must reach back to, because an earlier
  /// forward walk stopped before covering its window. Null when no forward walk
  /// is owed anything.
  ///
  /// The forward walk goes newest → oldest like every Tracearr walk, so its
  /// first committed page moves `MAX(watchedAt)` — the forward watermark — to
  /// "now". A walk that then stops (Stop, the stream's lifetime cap, a 429 that
  /// outlasted the retries, an error) leaves the plays between the OLD watermark
  /// and the oldest play it reached unread, and the next run's `since`, derived
  /// from the new MAX, starts above them. The backfill never reaches them either
  /// (it walks below `MIN`). Set to the walk's original `since` (only ever moved
  /// earlier) before a forward walk's first page that moves the watermark, and
  /// before EVERY page a forward walk writes without the account-name map (its
  /// rows carry identity labels until a healthy walk re-delivers them); cleared
  /// only when a walk WITH the map exhausts its window. While set there is a
  /// known gap: the importer does not re-establish `watchHistorySyncedAt`, and
  /// the evaluability guard refuses play-activity criteria for the server even
  /// where the marker from before the gap still stands.
  tracearrForwardFloorAt DateTime?
  /// The START of the newest forward walk that recorded
  /// `tracearrForwardFloorAt` (`GREATEST`, stamped on every record even when
  /// the floor keeps its value). A walk may clear the floor only if this is no
  /// later than its own start: a walk that started later can have left plays
  /// newer than that start unread. The recorder's start rather than the record
  /// time, or no walk could ever pay the floor it recorded itself. Null clears.
  tracearrForwardFloorRecordedAt DateTime?
  /// When a BACKFILL walk last actually ran for the current mapping — set by
  /// every backfill pass that fetched from Tracearr, whether it exhausted the
  /// archive or stopped at its slice; null until the first one runs, and reset
  /// to null whenever the walk is restarted (purge, disable-with-delete, a
  /// restore that emptied the rows) or the mapping changes. Lets the status
  /// readout tell "never attempted yet" (a fresh mapping waiting for its first
  /// import) apart from "walked and found nothing to import".
  tracearrBackfillLastWalkAt DateTime?
  /// Set while some of this server's media rows are known to be missing and
  /// only a complete library sync brings them back — after items were deleted
  /// in bulk (a purge, disable-with-delete, a restore whose file lacked them, a
  /// vanished-library purge) or while a library that held no items is being
  /// populated for the first time (`requireLibraryResync`). Those items come
  /// back as fresh rows with none of their plays, and a history pass that ran
  /// before they existed could not attach any. So while this is set:
  /// `watchHistorySyncedAt` cannot be re-established (native or Tracearr), the
  /// evaluability guard refuses play-activity criteria for the server, and a
  /// Tracearr archive walk is held. Not inferred from the other columns: a
  /// first walk that failed after committing a page leaves exactly the shape a
  /// restart does.
  ///
  /// Holds the EARLIEST unreleased request: a later request leaves it as is
  /// (and is noted in-process, so a sync whose pass began before that request
  /// cannot release it). Every cause leaves the library it waits on with no
  /// `MediaItem` created before its own instant, which is how a release tells
  /// the libraries a hold waits for from those it left alone. Cleared by a
  /// full, uncancelled library sync that brought every waited-for library back
  /// (`releaseLibraryResyncHold`), or by the library-scoped sync that took a
  /// library's own population hold once that library is synced
  /// (`releaseOwnPopulationHold`). A mapping change does NOT clear it: the hold
  /// is about the library, not the mapping.
  libraryResyncRequiredAt DateTime?
  /// Bumped by every change of `tracearrServerId` (the server PUT), including
  /// an unlink and a re-link to the same Tracearr server. Every write the
  /// Tracearr importer makes is conditional on the mapping AND this version, so
  /// a run that started before an unlink-and-relink cannot write the old walk's
  /// state over the reset the relink made.
  tracearrMappingVersion Int @default(0)
  /// For a mapping with no stored Tracearr rows (so no `MAX(watchedAt)` to
  /// derive the forward pass's `since` from): the instant every play started
  /// before is known to have been read by some walk of this archive. Set when a
  /// backfill walk starts from the newest play, moved to "now" by a restart, and
  /// advanced by a healthy forward walk that read its whole window. Null for a
  /// mapping never walked; reset whenever the mapping changes.
  tracearrForwardWatermarkAt DateTime?
  /// Whether the one-time backfill of this server's Tracearr history has walked
  /// all the way to the oldest play.
  ///
  /// Tracearr returns history **newest first**, so `MAX(watchedAt)` — the
  /// forward watermark — is set by the very first page and says nothing about
  /// how far back the import got. Without this flag an import interrupted at
  /// any point (crash, container restart, the request's lifetime cap, or the
  /// user pressing Stop) would resume from that watermark and silently abandon
  /// everything older, reporting success. Cleared whenever the mapping changes,
  /// because the rows it describes are wiped at the same time.
  tracearrBackfillComplete Boolean         @default(false)
  libraries                Library[]
  syncJobs                 SyncJob[]
  watchHistory             WatchHistory[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model SonarrInstance {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  url                   String
  apiKey                String
  externalUrl           String?
  enabled               Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  trashManagedResources TrashManagedResource[]

  @@index([userId])
}

model RadarrInstance {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  url                   String
  apiKey                String
  externalUrl           String?
  enabled               Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  trashManagedResources TrashManagedResource[]

  @@index([userId])
}

model LidarrInstance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  url         String
  apiKey      String
  externalUrl String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SeerrInstance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  apiKey    String
  /// Browser-facing base URL for "Open in Seerr" links; `url` is used when null.
  externalUrl String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A Tracearr instance (self-hosted Plex/Jellyfin/Emby playback monitor).
/// One instance aggregates many media servers, so the per-server link lives on
/// `MediaServer.tracearrServerId` — see the notes there.
model TracearrInstance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  apiKey    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum LibraryType {
  MOVIE
  SERIES
  MUSIC
}

model Library {
  id            String       @id @default(cuid())
  mediaServerId String?
  mediaServer   MediaServer? @relation(fields: [mediaServerId], references: [id], onDelete: SetNull)
  key           String
  title         String
  type          LibraryType
  enabled       Boolean      @default(true)
  lastSyncedAt  DateTime?
  /// When this library's last pass ended short of the server's reported total
  /// but within the release tolerance, while a library-resync hold waited for
  /// it. A hold counts such a library as synced only on the SECOND such pass
  /// in a row — a server that over-reports is consistently short, a listing
  /// cut short once is not. Persisted so the two passes may span a restart;
  /// cleared by any other outcome of a pass, and by a pass that starts on an
  /// empty library.
  shortPassSeenAt DateTime?
  mediaItems    MediaItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([mediaServerId, key])
}

model MediaItem {
  id                     String                @id @default(cuid())
  libraryId              String
  library                Library               @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  ratingKey              String
  parentRatingKey        String?
  grandparentRatingKey   String?
  title                  String
  year                   Int?
  type                   LibraryType
  summary                String?
  thumbUrl               String?
  artUrl                 String?
  parentThumbUrl         String?
  parentSummary          String?
  seasonThumbUrl         String?
  parentTitle            String?
  albumTitle             String?
  seasonNumber           Int?
  episodeNumber          Int?
  // Content metadata
  contentRating          String?
  rating                 Float?
  audienceRating         Float?
  userRating             Float?
  studio                 String?
  tagline                String?
  originalTitle          String?
  originallyAvailableAt  DateTime?
  viewOffset             Int?
  // Genres, directors, etc. stored as JSON arrays of tag names
  genres                 Json?
  directors              Json?
  writers                Json?
  roles                  Json?
  countries              Json?
  // Video metadata
  resolution             String?
  videoWidth             Int?
  videoHeight            Int?
  videoCodec             String?
  videoProfile           String?
  videoFrameRate         String?
  videoBitDepth          Int?
  videoBitrate           Int?
  videoColorPrimaries    String?
  videoColorRange        String?
  videoChromaSubsampling String?
  aspectRatio            String?
  scanType               String?
  // Audio metadata
  audioCodec             String?
  audioChannels          Int?
  audioProfile           String?
  audioBitrate           Int?
  audioSamplingRate      Int?
  // File metadata
  container              String?
  dynamicRange           String?
  optimizedForStreaming  Boolean?
  fileSize               BigInt?
  filePath               String?
  duration               Int?
  // Enriched metadata (from per-item endpoint)
  titleSort              String?
  ratingCount            Int?
  ratingImage            String?
  audienceRatingImage    String?
  absoluteIndex          Int?
  chapterSource          String?
  labels                 Json?
  videoRangeType         String?
  // Playback
  playCount              Int                   @default(0)
  lastPlayedAt           DateTime?
  addedAt                DateTime?
  serverUpdatedAt        DateTime?
  // Dedup
  dedupKey               String?
  dedupCanonical         Boolean               @default(true)
  // Series identity (see src/lib/media/series-key.ts). Set by the sync for
  // SERIES episodes only: "tvdb:<id>" / "tmdb:<id>" from the show-level
  // external ids, else "title:<lower(trim(parentTitle))>". Every series-level
  // grouping (library, rule engines, watch history) keys on this, never on the
  // ambiguous parentTitle. Null for movies and tracks.
  seriesKey              String?
  isWatchlisted          Boolean               @default(false)
  streams                MediaStream[]
  externalIds            MediaItemExternalId[]
  lifecycleActions       LifecycleAction[]
  lifecycleExceptions    LifecycleException[]
  ruleMatches            RuleMatch[]
  watchHistory           WatchHistory[]        @relation("WatchHistoryItem")
  /// Plays filed against another copy whose primary row is filed here — see
  /// `WatchHistory.fanOutOfItemId`.
  watchHistoryFanOutCopies WatchHistory[]      @relation("WatchHistoryFanOut")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([libraryId, ratingKey])
  @@index([type])
  @@index([type, title])
  @@index([dedupKey])
  @@index([type, dedupCanonical, title])
  @@index([type, seriesKey])
  @@index([resolution])
  @@index([playCount])
  @@index([lastPlayedAt])
  @@index([parentTitle])
  @@index([albumTitle])
  @@index([contentRating])
  @@index([contentRating, type])
  @@index([studio])
  @@index([studio, type])
  @@index([addedAt])
  @@index([videoCodec, type])
  @@index([audioCodec, type])
  @@index([dynamicRange, type])
  @@index([container, type])
  @@index([originallyAvailableAt])
  @@index([year, type])
  @@index([isWatchlisted, type])
}

model MediaItemExternalId {
  id          String    @id @default(cuid())
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  source      String
  externalId  String
  createdAt   DateTime  @default(now())

  @@unique([mediaItemId, source])
  @@index([source, externalId])
}

model MediaStream {
  id                   String    @id @default(cuid())
  mediaItemId          String
  mediaItem            MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  streamType           Int // 1=video, 2=audio, 3=subtitle
  index                Int?
  codec                String?
  profile              String?
  bitrate              Int?
  isDefault            Boolean   @default(false)
  displayTitle         String?
  extendedDisplayTitle String?
  language             String?
  languageCode         String?
  // Video
  width                Int?
  height               Int?
  frameRate            Float?
  scanType             String?
  colorPrimaries       String?
  colorRange           String?
  chromaSubsampling    String?
  bitDepth             Int?
  videoRangeType       String?
  // Audio
  channels             Int?
  samplingRate         Int?
  audioChannelLayout   String?
  // Subtitle
  forced               Boolean?
  createdAt            DateTime  @default(now())

  @@index([mediaItemId])
  @@index([mediaItemId, streamType])
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model SyncJob {
  id              String        @id @default(cuid())
  mediaServerId   String
  mediaServer     MediaServer   @relation(fields: [mediaServerId], references: [id], onDelete: Cascade)
  status          SyncJobStatus @default(PENDING)
  cancelRequested Boolean       @default(false)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  error           String?
  itemsProcessed  Int           @default(0)
  totalItems      Int           @default(0)
  currentLibrary  String?

  @@index([mediaServerId, status])
}

model RuleSet {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  type                   LibraryType
  rules                  Json
  enabled                Boolean           @default(true)
  seriesScope            Boolean           @default(true)
  actionEnabled          Boolean           @default(false)
  actionType             String?
  actionDelayDays        Int               @default(7)
  arrInstanceId          String?
  targetQualityProfileId Int?
  addImportExclusion     Boolean           @default(false)
  searchAfterAction      Boolean           @default(false)
  addArrTags             String[]          @default([])
  removeArrTags          String[]          @default([])
  collectionId           String?
  collection             Collection?       @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  discordNotifyOnAction  Boolean           @default(false)
  discordNotifyOnMatch   Boolean           @default(false)
  stickyMatches          Boolean           @default(false)
  serverIds              String[]          @default([])
  lifecycleActions       LifecycleAction[]
  ruleMatches            RuleMatch[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([collectionId])
}

// A reusable, named Plex collection definition that multiple RuleSets can sync
// into ("merge"). Owns the collection-level presentation settings (sort order,
// sort title, home-screen / recommended visibility) so that every rule feeding
// the same collection shares one source of truth. Scoped by LibraryType because
// a Plex collection lives inside a single library type (Movies/Series/Music).
model Collection {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        LibraryType
  sortName    String?
  homeScreen  Boolean     @default(false)
  recommended Boolean     @default(false)
  sort        String      @default("ALPHABETICAL")
  ruleSets    RuleSet[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, type, name])
  @@index([userId])
}

enum LifecycleActionStatus {
  PENDING
  COMPLETED
  FAILED
}

model LifecycleAction {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId            String?
  mediaItem              MediaItem?            @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)
  mediaItemTitle         String?
  mediaItemParentTitle   String?
  /// The item's year and the external id its Arr app resolves it by (TMDB for
  /// a movie, TVDB for a series, MusicBrainz for music — `arrIdSourceFor`), as
  /// they were when the action was scheduled. With the titles above, this is
  /// the identity the scheduled executor re-checks before it acts: a Fix Match
  /// that keeps the title ("Dune" 1984 → 2021) changes only these.
  mediaItemYear          Int?
  mediaItemExternalId    String?
  /// An episode's season and episode numbers (SERIES only), so the history of
  /// an action on ONE episode still names it "<Show> SxxExx" once the
  /// episode's MediaItem row is gone.
  mediaItemSeasonNumber  Int?
  mediaItemEpisodeNumber Int?
  ruleSetId              String?
  ruleSet                RuleSet?              @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
  ruleSetName            String?
  ruleSetType            String?
  actionType             String
  status                 LifecycleActionStatus @default(PENDING)
  scheduledFor           DateTime
  executedAt             DateTime?
  error                  String?
  arrInstanceId          String?
  targetQualityProfileId Int?
  addImportExclusion     Boolean               @default(false)
  searchAfterAction      Boolean               @default(false)
  matchedMediaItemIds    String[]              @default([])
  addArrTags             String[]              @default([])
  removeArrTags          String[]              @default([])
  externalMediaId        Int?
  deletedBytes           BigInt?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([ruleSetId])
  @@index([mediaItemId])
  @@index([userId])
}

model RuleMatch {
  id          String    @id @default(cuid())
  ruleSetId   String
  ruleSet     RuleSet   @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  itemData    Json
  /// Other servers' copies of the title this match was collapsed from (the ids
  /// in itemData.copies), as a column so "is this item matched as a copy" is
  /// an index probe rather than a scan over every match's JSON.
  copyIds     String[]  @default([])
  detectedAt  DateTime  @default(now())

  // [ruleSetId] alone is covered by the composite unique's leading column.
  @@unique([ruleSetId, mediaItemId])
  @@index([copyIds], type: Gin)
}

model LifecycleException {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([userId, mediaItemId])
  @@index([userId])
}

model SystemConfig {
  id             String   @id @default("singleton")
  plexClientId   String
  setupCompleted Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum LogCategory {
  BACKEND
  API
  DB
}

model LogEntry {
  id        String      @id @default(cuid())
  level     LogLevel
  category  LogCategory @default(BACKEND)
  source    String
  message   String
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([level])
  @@index([category])
  @@index([source])
  @@index([createdAt])
}

model BlackoutSchedule {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  enabled       Boolean   @default(true)
  scheduleType  String // "one_time" | "recurring"
  startDate     DateTime?
  endDate       DateTime?
  daysOfWeek    Json? // [0,1,2,3,4,5,6] where 0=Sunday
  startTime     String? // "HH:mm"
  endTime       String? // "HH:mm"
  action        String // "terminate_immediate" | "warn_then_terminate" | "block_new_only"
  message       String    @default("Stream terminated due to scheduled blackout period.")
  delay         Int       @default(30)
  excludedUsers String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([enabled])
}

model PrerollPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PrerollSchedule {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  enabled      Boolean   @default(true)
  prerollPath  String
  scheduleType String // "one_time" | "recurring" | "seasonal"
  startDate    DateTime?
  endDate      DateTime?
  daysOfWeek   Json? // [0..6]
  startTime    String? // "HH:mm"
  endTime      String? // "HH:mm"
  priority     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([enabled])
}

model SavedQuery {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// One play event. Two provenances, distinguished by `source`:
///
///  - `NATIVE` — from the media server's own history
///    (`getDetailedWatchHistory()`), full-replaced on every sync. Every
///    Tracearr-only column below stays null, including `watched`.
///  - `TRACEARR` — from Tracearr's `/api/v2/public/history`, appended
///    incrementally and deduped on `(mediaServerId, sourceEventId)`.
///
/// **`watched` is the reconcile lynchpin.** A Tracearr record is an aggregate
/// over a *resume chain*, so it can describe a partial or still-playing view
/// (`watched = false`). Those rows are stored and displayed but must never
/// inflate `MediaItem.playCount` or advance `lastPlayedAt`, so both queries in
/// `watch-reconcile.ts` count only rows where `watched IS DISTINCT FROM false`
/// — native rows (null) keep counting exactly as they always did.
model WatchHistory {
  id             String      @id @default(cuid())
  mediaItemId    String
  mediaItem      MediaItem   @relation("WatchHistoryItem", fields: [mediaItemId], references: [id], onDelete: Cascade)
  /// Set on a row that duplicates a play also filed against ANOTHER copy of
  /// the same item: the id of that copy (the primary row's `mediaItemId`).
  /// Jellyfin/Emby can list one item in two libraries over the same folder,
  /// and the native sync files the play against each copy so each reads as
  /// watched to the rules — but a list of PLAYS must show it once, so the
  /// History page, the series play lists and the watch analytics skip rows
  /// where this is set. `SetNull`: if the primary copy is deleted, this row is
  /// shown again — with two copies it is the play's one record; with three or
  /// more every remaining copy's row is, so the play shows once per remaining
  /// copy until the next native full replace re-points them.
  fanOutOfItemId String?
  fanOutOf       MediaItem?  @relation("WatchHistoryFanOut", fields: [fanOutOfItemId], references: [id], onDelete: SetNull)
  mediaServerId  String
  mediaServer    MediaServer @relation(fields: [mediaServerId], references: [id], onDelete: Cascade)
  serverUsername String
  watchedAt      DateTime?
  deviceName     String?
  platform       String?
  createdAt      DateTime    @default(now())

  /// Provenance: "NATIVE" | "TRACEARR". The migration default correctly tags
  /// every pre-existing row as NATIVE.
  source        String  @default("NATIVE")
  /// Tracearr's stable chain id for the play (its `id`, a uuid). Null for
  /// native rows — Postgres treats nulls as distinct in a unique index, so the
  /// dedup constraint below does not collide across native rows.
  sourceEventId String?
  /// Tracearr `reference_id`. Documented as the chain key shared by every
  /// segment of the play; in the current spec it always equals `id`, so
  /// `segmentCount` is what actually reveals a resumed play.
  referenceId   String?

  /// True once the play crossed Tracearr's per-media-type completion threshold
  /// (85% by default). See the model comment — this drives the reconcile.
  watched         Boolean?
  /// Playback progress 0-100 (Tracearr `percent_complete`); the headline
  /// completion figure, and nullable even when progress/duration are known.
  percentComplete Float?
  /// Most recent segment's state: "playing" | "paused" | "stopped".
  state           String?

  /// Playback position in ms (Tracearr `progress_ms`).
  progressMs      Int?
  /// Watch time summed across the play's in-window segments (`duration_ms`).
  durationMs      Int?
  /// The item's full runtime in ms (`total_duration_ms`) — the denominator
  /// `durationMs`/`progressMs` are measured against.
  totalDurationMs Int?
  /// Number of sessions in the resume chain (`segment_count`); > 1 means the
  /// play was resumed.
  segmentCount    Int?
  stoppedAt       DateTime?

  player  String?
  product String?

  isTranscode   Boolean?
  /// "directplay" | "copy" | "transcode".
  videoDecision String?
  audioDecision String?

  /// Stream bitrate in kbps.
  bitrate          Int?
  resolution       String?
  sourceVideoCodec String?
  sourceAudioCodec String?
  streamVideoCodec String?
  streamAudioCodec String?

  /// Tracearr `transcode_info` verbatim (container decision, hw encode/decode,
  /// speed, throttled, reasons).
  transcodeInfo Json?
  /// Tracearr `subtitle_info` verbatim (decision, codec, language, forced).
  subtitleInfo  Json?
  /// The source_/stream_ video+audio detail objects and their display strings,
  /// bundled — full fidelity without 20+ scalar columns.
  streamQuality Json?

  @@unique([mediaServerId, sourceEventId])
  @@index([mediaItemId])
  // Backs the `SetNull` above: without it every MediaItem delete scans the
  // whole table for fan-out copies pointing at it.
  @@index([fanOutOfItemId])
  @@index([mediaServerId])
  @@index([serverUsername])
  @@index([watchedAt])
  // The incremental native refresh resolves its window from MAX("watchedAt")
  // per server and dedups against the rows at or after it; both are one index
  // probe with this, and a scan of the server's whole history without it.
  @@index([mediaServerId, watchedAt])
  @@index([deviceName])
  @@index([platform])
  @@index([source])
  @@index([watched])
  @@index([isTranscode])
  @@index([player])
  @@index([resolution])
}

// Tracks which TRaSH Guides resources (custom formats, quality profiles,
// quality-size definitions, naming schemes) the user has explicitly assigned
// Librariarr to manage on a specific Sonarr/Radarr instance. A row exists ONLY
// after the user opts in ("assigns") the resource. No write is ever made to an
// Arr app for a resource that has no managed row — this is the consent gate.
// serviceType discriminates which nullable instance FK is populated; the FK
// cascades so deleting an instance drops its managed resources.
model TrashManagedResource {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType      String // "SONARR" | "RADARR"
  sonarrInstanceId String?
  sonarrInstance   SonarrInstance? @relation(fields: [sonarrInstanceId], references: [id], onDelete: Cascade)
  radarrInstanceId String?
  radarrInstance   RadarrInstance? @relation(fields: [radarrInstanceId], references: [id], onDelete: Cascade)
  resourceType     String // "CUSTOM_FORMAT" | "QUALITY_PROFILE" | "QUALITY_DEFINITION" | "NAMING"
  trashId          String // TRaSH trash_id (or a synthetic key for singleton resources like NAMING)
  name             String // display name captured at assignment time
  arrId            Int? // id of the resource inside the Arr once synced (null for bulk/config resources)
  selection        Json? // extra choices for the resource (e.g. chosen naming variants)
  lastSyncedAt     DateTime?
  lastSyncHash     String? // hash of the last-synced TRaSH definition, used to flag upstream guide changes
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // One managed row per (user, instance, resource). Two composite uniques —
  // one per instance FK — because exactly one FK is set per row; the other is
  // NULL (and Postgres treats NULLs as distinct, so each constraint only
  // governs the rows whose FK it names). Makes assignment an atomic upsert.
  //
  // Explicit short `map:` names: the auto-generated names are 69 chars, and
  // Postgres truncates identifiers to 63 — but Prisma's own 63-char truncation
  // keeps the `_key` suffix, so the two disagree and every `db push` / diff sees
  // phantom index drift. Short mapped names sidestep the truncation entirely.
  @@unique([userId, sonarrInstanceId, resourceType, trashId], map: "TrashManagedResource_sonarr_key")
  @@unique([userId, radarrInstanceId, resourceType, trashId], map: "TrashManagedResource_radarr_key")
  @@index([userId])
  @@index([sonarrInstanceId])
  @@index([radarrInstanceId])
}

/// A credential third-party applications use to call the public `/api/v1` API
/// (see `src/lib/api-keys/`). Only a salted scrypt hash of the key is stored:
/// the plaintext is returned once, by the create route, and cannot be
/// recovered afterwards. Deleting the row revokes the key on its very next
/// request — authentication reads this row on every call; what it remembers in
/// memory is only that a key's hash has already been verified.
///
/// Deliberately NOT in the backup's `TABLE_ORDER`: a restore truncates `User`
/// with CASCADE, so it wipes every key rather than resurrecting ones that were
/// deleted after the backup was taken.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// The key's leading characters (`lbr_` + 6), shown so a key can be told
  /// apart in the list, and how its row is found. Far too short to
  /// authenticate with.
  prefix     String
  /// Salted scrypt hash of the full key (`scrypt$N$r$p$salt$hash`), verified
  /// after the lookup by `prefix`. The plaintext is never stored.
  keyHash    String    @unique
  /// Granted scopes, stored explicitly (with implied read scopes expanded) so a
  /// scope added in a later version never silently widens an existing key.
  scopes     String[]
  /// null = never expires.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  lastUsedIp String?
  createdAt  DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@index([prefix])
}
