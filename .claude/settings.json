{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-build-before-commit.sh",
            "timeout": 600,
            "statusMessage": "Building the docs before this commit..."
          }
        ]
      }
    ]
  }
}
